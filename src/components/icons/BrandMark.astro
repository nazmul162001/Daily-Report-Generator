---
/**
 * Brand mark SVG (matches favicon concept: checklist report document).
 * Uses currentColor so parent controls color.
 */
interface Props {
  class?: string;
}
const { class: className = "h-5 w-5" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 32 32"
  fill="none"
  class={className}
  aria-hidden="true"
>
  <path
    d="M9 4.5h9.2L24 10.3V26a2.5 2.5 0 0 1-2.5 2.5h-12A2.5 2.5 0 0 1 7 26V7a2.5 2.5 0 0 1 2-2.5Z"
    fill="currentColor"
    fill-opacity="0.18"
  />
  <path
    d="M9 4.5h9.2L24 10.3V26a2.5 2.5 0 0 1-2.5 2.5h-12A2.5 2.5 0 0 1 7 26V7a2.5 2.5 0 0 1 2-2.5Z"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linejoin="round"
  />
  <path
    d="M18.2 4.5V8.8c0 .83.67 1.5 1.5 1.5H24"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linejoin="round"
  />
  <path
    d="M11.2 15.2 13 17l3.6-3.8"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    d="M11.2 20.6 13 22.4l3.6-3.8"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    d="M18.5 16.5h4.2M18.5 21.8h4.2"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
  />
</svg>
