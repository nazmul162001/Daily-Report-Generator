---
import "../../styles/global.css";
import Seo from "./Seo.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Daily Report Generator",
  description = "Create, preview and copy your daily work reports in seconds.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <Seo title={title} description={description} />
    {/* Apply theme before paint to avoid flash */}
    <script is:inline>
      (function () {
        try {
          // Default is always light; only honor an explicit user choice.
          var stored = localStorage.getItem("theme");
          var theme = stored === "dark" ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", theme);
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) {
            meta.setAttribute(
              "content",
              theme === "dark" ? "#1c2338" : "#2563eb",
            );
          }
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col bg-background text-text">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-primary focus:px-3 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <Header />
    <main id="main-content" class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 sm:px-6 sm:py-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
