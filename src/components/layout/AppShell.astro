---
import "../../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Seo from "./Seo.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import InstallPrompt from "./InstallPrompt.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Daily Report Generator",
  description = "Create, preview and copy your daily work reports in seconds.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <Seo title={title} description={description} />
    {/* SPA-style client-side routing (no full page reload between routes) */}
    <ClientRouter />
    {/*
      Theme bootstrap: default light, persist via localStorage.
      ClientRouter soft-nav swaps HTML that hardcodes data-theme="light",
      so we re-apply the saved theme on before-swap / after-swap / page-load.
    */}
    <script is:inline>
      (function () {
        if (window.__themeBootstrap) return;
        window.__themeBootstrap = true;

        function readTheme() {
          try {
            return localStorage.getItem("theme") === "dark" ? "dark" : "light";
          } catch (_) {
            return "light";
          }
        }

        function applyThemeTo(doc, theme) {
          if (!doc || !doc.documentElement) return;
          doc.documentElement.setAttribute("data-theme", theme);
          var meta = doc.querySelector('meta[name="theme-color"]');
          if (meta) {
            meta.setAttribute(
              "content",
              theme === "dark" ? "#1c2338" : "#2563eb",
            );
          }
        }

        function applySavedTheme() {
          applyThemeTo(document, readTheme());
        }

        // First paint / hard reload
        applySavedTheme();

        // Soft nav: stamp theme onto the incoming document *before* DOM swap
        document.addEventListener("astro:before-swap", function (event) {
          if (event && event.newDocument) {
            applyThemeTo(event.newDocument, readTheme());
          }
        });

        // Soft nav: ensure live document still matches storage after swap
        document.addEventListener("astro:after-swap", applySavedTheme);
        document.addEventListener("astro:page-load", applySavedTheme);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col bg-background text-text">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-primary focus:px-3 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <Header />
    <main
      id="main-content"
      class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 sm:px-6 sm:py-8"
      transition:animate="fade"
      transition:name="page-main"
    >
      <slot />
    </main>
    <Footer />
    <InstallPrompt />
  </body>
</html>
