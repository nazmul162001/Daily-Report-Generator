---
const year = new Date().getFullYear();
---

<footer
  class="mt-auto border-t border-border bg-surface"
  transition:persist="site-footer"
  transition:name="site-footer"
>
  <div class="mx-auto flex max-w-[96rem] flex-col gap-1 py-4 text-center text-xs text-muted sm:flex-row sm:items-center sm:justify-between sm:text-left pl-[max(1rem,env(safe-area-inset-left))] pr-[max(1rem,env(safe-area-inset-right))] pb-[max(1rem,env(safe-area-inset-bottom))] sm:pl-[max(1.5rem,env(safe-area-inset-left))] sm:pr-[max(1.5rem,env(safe-area-inset-right))]">
    <p>© {year} Daily Report Generator</p>
    <p>Data stays in your browser · No account required</p>
  </div>
</footer>
