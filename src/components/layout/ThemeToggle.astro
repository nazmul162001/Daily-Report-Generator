---
/**
 * Telegram-style circular theme reveal.
 * Always blooms from the sun/moon control (header top-right).
 */
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle group relative inline-flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-border bg-background text-text shadow-sm transition-all duration-200 hover:border-primary/35 hover:bg-primary/10 hover:text-primary hover:shadow-md active:scale-95 sm:h-10 sm:w-10"
  aria-label="Toggle color theme"
  title="Toggle dark / light mode"
>
  <span
    class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    style="background: radial-gradient(circle at center, var(--c-primary-soft), transparent 70%);"
    aria-hidden="true"
  ></span>

  <svg
    class="theme-icon-moon relative h-[1.15rem] w-[1.15rem] transition-transform duration-300 group-hover:-rotate-12"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"></path>
  </svg>

  <svg
    class="theme-icon-sun relative h-[1.15rem] w-[1.15rem] text-amber-300 transition-transform duration-300 group-hover:rotate-45"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    if (!btn || btn.dataset.bound === "1") return;
    btn.dataset.bound = "1";

    var busy = false;
    /** Reveal length — keep in sync with wait below. */
    var DURATION = 480;

    function currentTheme() {
      return document.documentElement.getAttribute("data-theme") === "dark"
        ? "dark"
        : "light";
    }

    function themeMeta(theme) {
      return theme === "dark" ? "#1c2338" : "#2563eb";
    }

    function applyLabel(theme) {
      var next = theme === "dark" ? "light" : "dark";
      btn.setAttribute("aria-label", "Switch to " + next + " mode");
      btn.setAttribute("title", "Switch to " + next + " mode");
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute("content", themeMeta(theme));
    }

    function setTheme(theme) {
      document.documentElement.setAttribute("data-theme", theme);
      try {
        localStorage.setItem("theme", theme);
      } catch (_) {}
      applyLabel(theme);
    }

    function prefersReducedMotion() {
      return (
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
      );
    }

    /**
     * Origin for the bloom — ALWAYS header toggle / top-right.
     * Uses % of the snapshot (viewport) so the browser never remaps
     * pixel coords to the layer center.
     */
    function getOriginPercents() {
      var vw = window.innerWidth || 1;
      var vh = window.innerHeight || 1;
      var el = document.getElementById("theme-toggle");
      // Default: top-right gutter (matches header control area)
      var xPct = 96.5;
      var yPct = 4.5;

      if (el) {
        var r = el.getBoundingClientRect();
        if (r.width > 0 && r.height > 0) {
          xPct = ((r.left + r.width / 2) / vw) * 100;
          yPct = ((r.top + r.height / 2) / vh) * 100;
        }
      }

      // Force top-right quadrant — never allow center origins
      if (!(xPct > 70)) xPct = 96.5;
      if (!(yPct < 20)) yPct = 4.5;
      if (!Number.isFinite(xPct) || !Number.isFinite(yPct)) {
        xPct = 96.5;
        yPct = 4.5;
      }

      return {
        x: Math.min(99, Math.max(70, +xPct.toFixed(3))),
        y: Math.min(18, Math.max(1, +yPct.toFixed(3))),
      };
    }

    /**
     * Radius as % of box diagonal reference so a single value
     * always fully covers any viewport (no end snap).
     */
    function coverRadiusPercent(xPct, yPct) {
      // Corners of a 0–100 box, distance in % units (euclidean on % space)
      var corners = [
        [0, 0],
        [100, 0],
        [0, 100],
        [100, 100],
      ];
      var max = 0;
      for (var i = 0; i < corners.length; i++) {
        var dx = corners[i][0] - xPct;
        var dy = corners[i][1] - yPct;
        // Convert % of width/height to roughly normalized distance;
        // use max side so circle(r%) with CSS % radius (relative to diagonal) clears fully.
        var d = Math.hypot(dx, dy);
        if (d > max) max = d;
      }
      // CSS circle % radius is relative to diagonal ≈ 141% of shorter side.
      // 150 is safely past full cover for any origin in the box.
      return Math.ceil(Math.max(max * 1.35, 150));
    }

    async function toggleWithReveal() {
      if (busy) return;
      var next = currentTheme() === "dark" ? "light" : "dark";

      if (!document.startViewTransition || prefersReducedMotion()) {
        setTheme(next);
        return;
      }

      busy = true;
      var origin = getOriginPercents();
      var rPct = coverRadiusPercent(origin.x, origin.y);
      var from = "circle(0% at " + origin.x + "% " + origin.y + "%)";
      var to = "circle(" + rPct + "% at " + origin.x + "% " + origin.y + "%)";

      try {
        var transition = document.startViewTransition(function () {
          setTheme(next);
        });

        try {
          await transition.ready;
        } catch (_) {
          busy = false;
          return;
        }

        // Even speed all the way — no hard ease-out crawl + snap
        var anim = document.documentElement.animate(
          [{ clipPath: from }, { clipPath: to }],
          {
            duration: DURATION,
            // Smooth throughout; mild ease without stalling at the end
            easing: "cubic-bezier(0.45, 0.05, 0.55, 0.95)",
            fill: "both",
            pseudoElement: "::view-transition-new(root)",
          },
        );

        try {
          await Promise.all([
            anim.finished.catch(function () {}),
            transition.finished.catch(function () {}),
          ]);
        } catch (_) {}
      } finally {
        busy = false;
      }
    }

    applyLabel(currentTheme());
    btn.addEventListener("click", function (event) {
      event.preventDefault();
      toggleWithReveal();
    });
  })();
</script>
