---
/**
 * Telegram-style theme bloom — always from the header sun/moon (top-right).
 * Neutralizes View Transition default transforms (those pull the origin to center).
 */
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle group relative inline-flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-border bg-background text-text shadow-sm transition-all duration-200 hover:border-primary/35 hover:bg-primary/10 hover:text-primary hover:shadow-md active:scale-95 sm:h-10 sm:w-10"
  aria-label="Toggle color theme"
  title="Toggle dark / light mode"
>
  <span
    class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    style="background: radial-gradient(circle at center, var(--c-primary-soft), transparent 70%);"
    aria-hidden="true"
  ></span>

  <svg
    class="theme-icon-moon relative h-[1.15rem] w-[1.15rem] transition-transform duration-300 group-hover:-rotate-12"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"></path>
  </svg>

  <svg
    class="theme-icon-sun relative h-[1.15rem] w-[1.15rem] text-amber-300 transition-transform duration-300 group-hover:rotate-45"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    if (window.__themeToggleInit) return;
    window.__themeToggleInit = true;

    var STYLE_ID = "theme-circle-vt-style";
    var busy = false;
    /* Longer + near-linear = steady bloom, no end crawl/snap */
    var DURATION_MS = 640;

    function getBtn() {
      return document.getElementById("theme-toggle");
    }

    function currentTheme() {
      return document.documentElement.getAttribute("data-theme") === "dark"
        ? "dark"
        : "light";
    }

    function themeMeta(theme) {
      return theme === "dark" ? "#1c2338" : "#2563eb";
    }

    function applyLabel(theme) {
      var btn = getBtn();
      if (!btn) return;
      var next = theme === "dark" ? "light" : "dark";
      btn.setAttribute("aria-label", "Switch to " + next + " mode");
      btn.setAttribute("title", "Switch to " + next + " mode");
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute("content", themeMeta(theme));
    }

    function setTheme(theme) {
      document.documentElement.setAttribute("data-theme", theme);
      try {
        localStorage.setItem("theme", theme);
      } catch (_) {}
      applyLabel(theme);
    }

    function prefersReducedMotion() {
      return (
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
      );
    }

    /**
     * Always top-right. Prefer the toggle button rect, never center.
     * Returned as % of the VT layer so transform quirks can't remap px to center.
     */
    function getTopRightOriginPct(clickEvent) {
      var vw = window.innerWidth || 1;
      var vh = window.innerHeight || 1;
      var xPct = 97;
      var yPct = 3.5;
      var btn = getBtn();

      if (btn) {
        var r = btn.getBoundingClientRect();
        if (r.width > 0 && r.height > 0) {
          xPct = ((r.left + r.width / 2) / vw) * 100;
          yPct = ((r.top + r.height / 2) / vh) * 100;
        }
      } else if (
        clickEvent &&
        typeof clickEvent.clientX === "number" &&
        clickEvent.clientX > vw * 0.6
      ) {
        xPct = (clickEvent.clientX / vw) * 100;
        yPct = (clickEvent.clientY / vh) * 100;
      }

      // Hard clamp into the top-right corner — never allow center
      xPct = Math.min(99.2, Math.max(88, xPct));
      yPct = Math.min(12, Math.max(1.5, yPct));

      return {
        x: +xPct.toFixed(3),
        y: +yPct.toFixed(3),
      };
    }

    function removeStyle() {
      var el = document.getElementById(STYLE_ID);
      if (el) el.remove();
    }

    function injectStyle(xPct, yPct) {
      removeStyle();
      var style = document.createElement("style");
      style.id = STYLE_ID;
      /*
        Critical rules:
        1) Kill named layers so only root snapshots
        2) Kill default group TRANSFORMS (these create center morph)
        3) Expand clip with % origin — top-right of the layer
        4) Near-linear timing for continuous smooth motion
      */
      style.textContent = [
        "html.theme-revealing body *{view-transition-name:none!important}",

        "::view-transition{pointer-events:none}",

        /* Pin root group to the full viewport — no geometry morph */
        "::view-transition-group(root){",
        "animation:none!important;",
        "transform:none!important;",
        "top:0!important;left:0!important;right:0!important;bottom:0!important;",
        "width:100%!important;height:100%!important;",
        "}",

        "::view-transition-image-pair(root){",
        "isolation:isolate;",
        "}",

        "::view-transition-old(root),",
        "::view-transition-new(root){",
        "mix-blend-mode:normal;",
        "transform:none!important;",
        "top:0!important;left:0!important;",
        "width:100%!important;height:100%!important;",
        "object-fit:cover;",
        "}",

        /* Old theme stays fully visible underneath */
        "::view-transition-old(root){",
        "z-index:1;",
        "animation:none!important;",
        "}",

        /* New theme blooms as a circle from top-right */
        "::view-transition-new(root){",
        "z-index:2147483646;",
        "animation:theme-circle-reveal " +
          DURATION_MS +
          "ms cubic-bezier(0.33,0,0.2,1) both!important;",
        "}",

        "@keyframes theme-circle-reveal{",
        "0%{clip-path:circle(0% at " +
          xPct +
          "% " +
          yPct +
          "%)}",
        "100%{clip-path:circle(160% at " +
          xPct +
          "% " +
          yPct +
          "%)}",
        "}",
      ].join("");
      document.head.appendChild(style);
    }

    function doubleRaf() {
      return new Promise(function (resolve) {
        requestAnimationFrame(function () {
          requestAnimationFrame(resolve);
        });
      });
    }

    async function toggleWithReveal(clickEvent) {
      if (busy) return;
      var next = currentTheme() === "dark" ? "light" : "dark";

      if (!document.startViewTransition || prefersReducedMotion()) {
        setTheme(next);
        return;
      }

      busy = true;
      var root = document.documentElement;
      var origin = getTopRightOriginPct(clickEvent);

      injectStyle(origin.x, origin.y);
      root.classList.add("theme-revealing");
      await doubleRaf();

      try {
        var transition = document.startViewTransition(function () {
          setTheme(next);
        });

        // Backup WAAPI with the same % origin (in case CSS anim is dropped)
        try {
          await transition.ready;
          root.animate(
            [
              { clipPath: "circle(0% at " + origin.x + "% " + origin.y + "%)" },
              {
                clipPath:
                  "circle(160% at " + origin.x + "% " + origin.y + "%)",
              },
            ],
            {
              duration: DURATION_MS,
              easing: "cubic-bezier(0.33, 0, 0.2, 1)",
              fill: "both",
              pseudoElement: "::view-transition-new(root)",
            },
          );
        } catch (_) {}

        try {
          await transition.finished;
        } catch (_) {}
      } catch (_) {
        setTheme(next);
      } finally {
        // Small delay so the last frame paints before tearing down styles
        window.setTimeout(function () {
          root.classList.remove("theme-revealing");
          removeStyle();
          busy = false;
        }, 40);
      }
    }

    function bindClick() {
      var btn = getBtn();
      if (!btn || btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";
      applyLabel(currentTheme());
      btn.addEventListener("click", function (event) {
        event.preventDefault();
        toggleWithReveal(event);
      });
    }

    document.addEventListener("astro:page-load", bindClick);
    document.addEventListener("astro:after-swap", bindClick);
    bindClick();
  })();
</script>
