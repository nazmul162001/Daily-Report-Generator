---
import AppShell from "@/components/layout/AppShell.astro";
import { TimeTrackingPage } from "@/features/time-tracking/components/TimeTrackingPage";
---

<AppShell
  title="Activity | Daily Report Generator"
  description="Today's tracked time and completed task history."
>
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-text sm:text-3xl">Activity</h1>
    <p class="mt-1 text-sm text-muted">
      Today&apos;s summary of tracked work, plus history for the last 30 days.
    </p>
  </div>
  <TimeTrackingPage client:load />
</AppShell>
