---
import AppShell from "@/components/layout/AppShell.astro";
import { DetailedReportPage } from "@/features/detailed-report/components/DetailedReportPage";
---

<AppShell
  title="Detailed Report | Daily Report Generator"
  description="Compose detailed CMS reports with work breakdown and goals."
>
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-text sm:text-3xl">Detailed Report</h1>
    <p class="mt-1 text-sm text-muted">
      Stakeholder report with minutes, goals, and fixed recipients.
    </p>
  </div>
  <DetailedReportPage client:load />
</AppShell>
