---
import AppShell from "@/components/layout/AppShell.astro";
import { SavedReports } from "@/features/saved-reports/components/SavedReports";
---

<AppShell
  title="Saved Reports | Daily Report Generator"
  description="Browse, copy, and manage reports saved in your browser."
>
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-text sm:text-3xl">Saved Reports</h1>
    <p class="mt-1 text-sm text-muted">
      Stored locally in your browser. Replaceable with API later.
    </p>
  </div>
  <SavedReports client:load />
</AppShell>
